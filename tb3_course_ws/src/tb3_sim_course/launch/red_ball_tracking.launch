<launch>
  <arg name="model" default="waffle_pi"/>
  <arg name="ball_x" default="0.7"/>
  <arg name="ball_y" default="-0.1"/>
  <arg name="ball_z" default="0.18"/>
  <arg name="move_ball" default="true"/>
  <arg name="open_viewers" default="true"/>
  <arg name="linear_kp" default="0.015"/>
  <arg name="linear_ki" default="0.001"/>
  <arg name="linear_kd" default="0.0035"/>
  <arg name="angular_kp" default="0.010"/>
  <arg name="angular_ki" default="0.0002"/>
  <arg name="angular_kd" default="0.0035"/>
  <arg name="max_linear" default="0.48"/>
  <arg name="max_angular" default="1.90"/>

  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>
  <env name="GAZEBO_IP" value="127.0.0.1"/>
  <env name="GAZEBO_MODEL_PATH" value="$(find tb3_sim_course)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_world.launch">
    <arg name="model" value="$(arg model)"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_red_ball" output="screen"
        args="-sdf -file $(find tb3_sim_course)/models/red_ball/model.sdf -model red_ball -x $(arg ball_x) -y $(arg ball_y) -z $(arg ball_z)"/>

  <group if="$(arg move_ball)">
    <node pkg="tb3_sim_course" type="move_red_ball.py" name="move_red_ball" output="screen">
      <rosparam param="waypoints">
        [[-1.55, 0.55], [-0.55, 0.55], [0.55, 0.55], [1.55, 0.55],
         [1.55, -0.55], [0.55, -0.55], [-0.55, -0.55], [-1.55, -0.55]]
      </rosparam>
      <param name="speed" value="0.22"/>
      <param name="rate" value="60.0"/>
    </node>
  </group>

  <node pkg="tb3_sim_course" type="red_ball_tracker.py" name="red_ball_tracker" output="screen">
    <rosparam command="load" file="$(find tb3_sim_course)/config/red_ball_tracker.yaml"/>
    <param name="linear_kp" value="$(arg linear_kp)"/>
    <param name="linear_ki" value="$(arg linear_ki)"/>
    <param name="linear_kd" value="$(arg linear_kd)"/>
    <param name="angular_kp" value="$(arg angular_kp)"/>
    <param name="angular_ki" value="$(arg angular_ki)"/>
    <param name="angular_kd" value="$(arg angular_kd)"/>
    <param name="max_linear" value="$(arg max_linear)"/>
    <param name="max_angular" value="$(arg max_angular)"/>
  </node>

  <group if="$(arg open_viewers)">
    <node pkg="image_view" type="image_view" name="red_ball_raw_view" output="screen">
      <remap from="image" to="/camera/rgb/image_raw"/>
    </node>
    <node pkg="image_view" type="image_view" name="red_ball_mask_view" output="screen">
      <remap from="image" to="/red_ball/hsv_mask"/>
    </node>
    <node pkg="image_view" type="image_view" name="red_ball_debug_view" output="screen">
      <remap from="image" to="/red_ball/debug_image"/>
    </node>
  </group>
</launch>
