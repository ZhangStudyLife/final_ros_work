<launch>
  <arg name="model" default="waffle_pi"/>
  <arg name="map_file" default="$(find tb3_sim_course)/maps/turtlebot3_map.yaml"/>
  <arg name="open_rviz" default="true"/>
  <arg name="move_forward_only" default="false"/>
  <arg name="initial_pose_x" default="-2.0"/>
  <arg name="initial_pose_y" default="-0.5"/>
  <arg name="initial_pose_yaw" default="0.0"/>
  <arg name="auto_initial_pose" default="true"/>

  <env name="TURTLEBOT3_MODEL" value="$(arg model)"/>
  <env name="GAZEBO_IP" value="127.0.0.1"/>

  <include file="$(find turtlebot3_gazebo)/launch/turtlebot3_world.launch"/>
  <include file="$(find turtlebot3_navigation)/launch/turtlebot3_navigation.launch">
    <arg name="map_file" value="$(arg map_file)"/>
    <arg name="open_rviz" value="$(arg open_rviz)"/>
    <arg name="move_forward_only" value="$(arg move_forward_only)"/>
  </include>

  <group if="$(arg auto_initial_pose)">
    <node pkg="tb3_sim_course" type="initial_pose_pub.py" name="initial_pose_pub" output="screen">
      <param name="x" value="$(arg initial_pose_x)"/>
      <param name="y" value="$(arg initial_pose_y)"/>
      <param name="yaw" value="$(arg initial_pose_yaw)"/>
    </node>
  </group>
</launch>
